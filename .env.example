# AuditMind Production Environment Configuration

PROJECT_NAME="AuditMind API"
VERSION="1.0.0"

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=postgresql://auditmind_user:auditmind_password@localhost:5432/auditmind

# Security Secrets
SECRET_KEY=auditmind_production_super_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hindsight Persistent Memory Engine
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_BANK_ID=auditmind_org

# LLM Providers (Optional for cloud LLM reasoning)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Document Ingestion Chunker Settings
DOC_CHUNK_SIZE=500
DOC_CHUNK_OVERLAP=50
